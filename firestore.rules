rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // NOTE: This app has no staff login — the admin area is open.
    // These rules therefore allow the app to read/write without auth.
    // Anyone who knows the project URL can read/write, so keep the /admin
    // URL private. If you ever want to lock it down, add Firebase Auth and
    // change these to `if request.auth != null`.

    match /bookings/{id} { allow read, write: if true; }
    match /jobCards/{id} { allow read, write: if true; }
    match /invoices/{id} { allow read, write: if true; }
    match /counters/{id} { allow read, write: if true; }
  }
}
