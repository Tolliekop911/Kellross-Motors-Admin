rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public website may CREATE a booking, but not read/edit the book.
    match /bookings/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Everything else is staff-only (must be signed in).
    match /jobCards/{id}   { allow read, write: if request.auth != null; }
    match /invoices/{id}   { allow read, write: if request.auth != null; }
    match /counters/{id}   { allow read, write: if request.auth != null; }
  }
}
